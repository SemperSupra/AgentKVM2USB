# Bootstrap copies this to ignored .work/re/.env.re and writes immutable references to .work/re/.env.re.lock.
RE_INPUT_ROOT=./.work/re/input
RE_OUTPUT_ROOT=./.work/re/output
RE_PROJECT_ROOT=./.work/re/projects
RE_VENDOR_ROOT=./.work/vendor
RE_CACHE_ROOT=./.work/re/cache
GHIDRA_HEADLESS_MAXMEM=4G

RADARE2_IMAGE=radare/radare2:6.1.8
ANGR_IMAGE=angr/angr:latest
GHIDRA_IMAGE=agentkvm2usb/ghidra:12.1.2-upstream
BINWALK_IMAGE=agentkvm2usb/binwalk:3.1.0-upstream
RE_RUNNER_IMAGE=agentkvm2usb/re-runner:1
SYFT_IMAGE=anchore/syft:latest
TRIVY_IMAGE=aquasec/trivy:latest
