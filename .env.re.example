# Bootstrap copies this to ignored .work/re/.env.re and writes immutable references to .work/re/.env.re.lock.
# The Python base image is resolved to an immutable digest before the runner
# build and the digest is recorded in the image-lock provenance; the tag here is
# only the human-readable default seed.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
RE_INPUT_ROOT=./.work/re/input
RE_OUTPUT_ROOT=./.work/re/output
RE_PROJECT_ROOT=./.work/re/projects
RE_VENDOR_ROOT=./.work/vendor
RE_CACHE_ROOT=./.work/re/cache
GHIDRA_HEADLESS_MAXMEM=4G

RADARE2_IMAGE=radare/radare2:6.1.8
# angr runs in the project runner image, which pins angr in its Python
# requirements; the angr/angr publisher image is a bare dev base without angr.
ANGR_IMAGE=agentkvm2usb/re-runner:1
GHIDRA_IMAGE=agentkvm2usb/ghidra:12.1.2-upstream
BINWALK_IMAGE=agentkvm2usb/binwalk:3.1.0-upstream
RE_RUNNER_IMAGE=agentkvm2usb/re-runner:1
SYFT_IMAGE=anchore/syft:v1.19.0
TRIVY_IMAGE=aquasec/trivy:0.57.1
